// Cloudflare Workers config for getsabi.ng (deployed by Workers Builds on push to main).
// Static files are served from the project root; only /api/* runs worker.js first.
// Keep in sync with ../sabi-worker/wrangler.jsonc (manual `wrangler deploy` copy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabi-splash-page",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "getsabi.ng", "custom_domain": true }
  ],
  "observability": { "enabled": true },

  // Brevo settings. The API key is a Secret (npx wrangler secret put BREVO_API_KEY),
  // it must be an API key starting "xkeysib-", not an SMTP key ("xsmtpsib-").
  "vars": {
    "BREVO_LIST_ID": "5",
    "NOTIFY_EMAIL": "productsail.tech@gmail.com",
    "SENDER_EMAIL": "hello@getsabi.ng"
  }
}
